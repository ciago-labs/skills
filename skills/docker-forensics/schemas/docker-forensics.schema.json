{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentskills.io/schemas/docker-forensics/diagnostic-output.schema.json",
  "title": "DockerForensicsOutput",
  "type": "object",
  "required": [
    "status",
    "timestamp",
    "platform",
    "tool_versions",
    "findings",
    "metrics",
    "warnings",
    "recommendations",
    "errors"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "warning",
        "critical",
        "error"
      ]
    },
    "timestamp": {
      "type": "string",
      "minLength": 10
    },
    "platform": {
      "type": "object"
    },
    "tool_versions": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "severity",
          "classification",
          "title",
          "evidence",
          "likely_causes",
          "confidence",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3
          },
          "category": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "verified",
              "measured",
              "heuristic"
            ]
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "object"
          },
          "likely_causes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
